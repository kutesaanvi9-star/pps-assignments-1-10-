#include <stdio.h>
#include <time.h>

// Function to check whether a year is a leap year (Gregorian rules)
int isLeapYear(int year) {
    return (year % 400 == 0) || ((year % 4 == 0) && (year % 100 != 0));
}

// Function to determine the day of the week for Jan 1 of the given year (0 = Sun, 6 = Sat)
int getFirstDayOfYear(int year) {
    struct tm time_in = {0};
    time_in.tm_year = year - 1900; // years since 1900
    time_in.tm_mon = 0;            // January
    time_in.tm_mday = 1;           // 1st day
    mktime(&time_in);              // normalizes struct and fills tm_wday
    return time_in.tm_wday;
}

int main() {
    int year;
    const char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };
    int daysInMonth[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    printf("Enter the year: ");
    if (scanf("%d", &year) != 1 || year < 1900) {
        printf("Invalid input! Please enter a valid year (1900 or later).\n");
        return 1;
    }

    // Adjust February days if leap year
    if (isLeapYear(year)) {
        daysInMonth[1] = 29;
    }

    int startDay = getFirstDayOfYear(year);

    printf("\n==================== CALENDAR %d ====================\n", year);

    for (int m = 0; m < 12; m++) {
        printf("\n  --------------- %s %d ---------------\n", months[m], year);
        printf("  Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        // Print leading spaces for the first day of the month
        for (int space = 0; space < startDay; space++) {
            printf("     ");
        }

        // Print all days of the current month
        for (int day = 1; day <= daysInMonth[m]; day++) {
            printf("%5d", day);
            if (++startDay > 6) {
                startDay = 0;
                printf("\n");
            }
        }

        if (startDay != 0) {
            printf("\n");
        }
    }

    return 0;
}
