#include <stdio.h>

int main() {
    int choice;
    double num1, num2, result;

    printf("=== Basic Arithmetic Calculator ===\n");
    printf("1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");
    printf("5. Exit\n");

    printf("\nEnter your choice (1-5): ");
    scanf("%d", &choice);

    if (choice == 5) {
        printf("Exiting program.\n");
        return 0;
    }

    printf("Enter two numbers: ");
    scanf("%lf %lf", &num1, &num2);

    switch (choice) {
        case 1:
            result = num1 + num2;
            printf("Addition is = %.2lf\n", result);
            break;

        case 2:
            result = num1 - num2;
            printf("Subtraction is = %.2lf\n", result);
            break;

        case 3:
            result = num1 * num2;
            printf("Multiplication is = %.2lf\n", result);
            break;

        case 4:
            if (num2 == 0) {
                printf("Error: Division by zero is not allowed.\n");
            } else {
                result = num1 / num2;
                printf("Division is = %.2lf\n", result);
            }
            break;

        default:
            printf("Invalid choice! Please select an option between 1 and 5.\n");
    }

    return 0;
}
